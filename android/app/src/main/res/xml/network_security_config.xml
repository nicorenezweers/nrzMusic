<?xml version="1.0" encoding="utf-8"?>
<!-- Standard ist music.zweers.ch über HTTPS. Wer einen eigenen Server im Heimnetz einträgt
     (z. B. http://umbrel.local:8350), braucht unverschlüsseltes HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
